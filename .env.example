# WildFireAI Environment Configuration Example
# Copy this file to .env and configure your parameters if connecting to live NASA FIRMS API

# NASA FIRMS API Key (Optional for live satellite integration)
# Get key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# System Configuration
APP_ENV=development
LOG_LEVEL=INFO
MODEL_PATH=models/model.joblib
DATA_PATH=data/sample_data.csv
